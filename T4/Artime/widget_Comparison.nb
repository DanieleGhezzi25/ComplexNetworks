Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Functions", " ", "ER"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pkER", "[", 
     RowBox[{"meandeg_", ",", "nmax_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"meandeg", "^", "i"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "meandeg"}], "]"}]}], 
        RowBox[{"i", "!"}]], 
       FractionBox["1", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], "nmax"], 
         FractionBox[
          RowBox[{
           RowBox[{"meandeg", "^", "k"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", "meandeg"}], "]"}]}], 
          RowBox[{"k", "!"}]]}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lhsER", ":=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.01", ",", "1", ",", "0.02"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rhsERattacks", "[", 
      RowBox[{"meandeg_", ",", "nmax_", ",", "thresh_"}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], 
         RowBox[{"nmax", "-", "1"}]], 
        RowBox[{
         FractionBox["1", "meandeg"], 
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}], 
         RowBox[{
          RowBox[{"pkER", "[", 
           RowBox[{"meandeg", ",", "nmax"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"n", "+", "1", "+", "1"}], "]"}], "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"PhiHubs", "[", 
            RowBox[{
             RowBox[{"n", "+", "1"}], ",", "thresh"}], "]"}], "+", 
           RowBox[{
            RowBox[{"PhiHubs", "[", 
             RowBox[{
              RowBox[{"n", "+", "1"}], ",", "thresh"}], "]"}], "*", 
            SuperscriptBox["u", "n"]}]}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0.01", ",", "1", ",", "0.02"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GCERattacks", "[", 
     RowBox[{"meandeg_", ",", "nmax_", ",", "thresh_", ",", "u_"}], "]"}], ":=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "nmax"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"PhiHubs", "[", 
        RowBox[{"n", ",", "thresh"}], "]"}], "*", 
       RowBox[{
        RowBox[{"pkER", "[", 
         RowBox[{"meandeg", ",", "nmax"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"n", "+", "1"}], "]"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["u", "n"]}], ")"}]}], ")"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GiantComponentVsThreshERattacks", "[", 
     RowBox[{"meandeg_", ",", "nmax_", ",", "threshmin_", ",", "threshmax_"}],
      "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GCERattacks", "[", 
        RowBox[{"meandeg", ",", "nmax", ",", "varthresh", ",", "u"}], "]"}], "/.", 
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"u", "-", 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"n", "=", "0"}], 
               RowBox[{"nmax", "-", "1"}]], 
              RowBox[{
               FractionBox["1", "meandeg"], 
               RowBox[{"(", 
                RowBox[{"n", "+", "1"}], ")"}], 
               RowBox[{
                RowBox[{"pkER", "[", 
                 RowBox[{"meandeg", ",", "nmax"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"n", "+", "1", "+", "1"}], "]"}], "]"}], 
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", 
                 RowBox[{"PhiHubs", "[", 
                  RowBox[{
                   RowBox[{"n", "+", "1"}], ",", "varthresh"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"PhiHubs", "[", 
                   RowBox[{
                    RowBox[{"n", "+", "1"}], ",", "varthresh"}], "]"}], "*", 
                  SuperscriptBox["u", "n"]}]}], ")"}]}]}]}], "\[Equal]", 
            "0"}], " ", "&&", 
           RowBox[{"u", "<=", "1"}], " ", "&&", " ", 
           RowBox[{"u", ">=", "0"}]}], ",", "u", ",", "Reals"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"varthresh", ",", "threshmin", ",", "threshmax", ",", "1"}], 
       "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GiantComponentVsMeanDegreeER", "[", 
     RowBox[{
     "thresh_", ",", "nmax_", ",", "meandegmin_", ",", "meandegmax_"}], "]"}],
     ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GCERattacks", "[", 
        RowBox[{"varmeandeg", ",", "nmax", ",", "thresh", ",", "u"}], "]"}], "/.", 
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"u", "-", 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"n", "=", "0"}], 
               RowBox[{"nmax", "-", "1"}]], 
              RowBox[{
               FractionBox["1", "varmeandeg"], 
               RowBox[{"(", 
                RowBox[{"n", "+", "1"}], ")"}], 
               RowBox[{
                RowBox[{"pkER", "[", 
                 RowBox[{"varmeandeg", ",", "nmax"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"n", "+", "1", "+", "1"}], "]"}], "]"}], 
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", 
                 RowBox[{"PhiHubs", "[", 
                  RowBox[{
                   RowBox[{"n", "+", "1"}], ",", "thresh"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"PhiHubs", "[", 
                   RowBox[{
                    RowBox[{"n", "+", "1"}], ",", "thresh"}], "]"}], "*", 
                  SuperscriptBox["u", "n"]}]}], ")"}]}]}]}], "\[Equal]", 
            "0"}], " ", "&&", 
           RowBox[{"u", "<=", "1"}], " ", "&&", " ", 
           RowBox[{"u", ">=", "0"}]}], ",", "u", ",", "Reals"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
       "varmeandeg", ",", "meandegmin", ",", "meandegmax", ",", "0.1"}], 
       "}"}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GCERrandom", "[", 
     RowBox[{"meandeg_", ",", "nmax_", ",", "phi_", ",", "u_"}], "]"}], ":=", 
    
    RowBox[{"phi", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "nmax"], 
        RowBox[{
         RowBox[{
          RowBox[{"pkER", "[", 
           RowBox[{"meandeg", ",", "nmax"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"n", "+", "1"}], "]"}], "]"}], "*", 
         SuperscriptBox["u", "n"]}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GiantComponentVsPhiER", "[", 
     RowBox[{"meandeg_", ",", "nmax_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GCERrandom", "[", 
        RowBox[{"meandeg", ",", "nmax", ",", "varphi", ",", "u"}], "]"}], "/.", 
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"u", "-", 
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "varphi", "+", 
               RowBox[{"varphi", "*", 
                FractionBox["1", "meandeg"], 
                RowBox[{
                 UnderoverscriptBox["\[Sum]", 
                  RowBox[{"n", "=", "0"}], 
                  RowBox[{"nmax", "-", "1"}]], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"n", "+", "1"}], ")"}], 
                  RowBox[{
                   RowBox[{"pkER", "[", 
                    RowBox[{"meandeg", ",", "nmax"}], "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "+", "1", "+", "1"}], "]"}], "]"}], "*", 
                  SuperscriptBox["u", "n"]}]}]}]}], ")"}]}], "\[Equal]", 
            "0"}], " ", "&&", 
           RowBox[{"u", "<=", "1"}], " ", "&&", " ", 
           RowBox[{"u", ">=", "0"}]}], ",", "u", ",", "Reals"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"varphi", ",", "0.01", ",", "1", ",", "0.01"}], "}"}]}], 
     "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
