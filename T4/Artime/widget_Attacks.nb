 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Functions", " ", "ER"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pkER", "[", 
     RowBox[{"meandeg_", ",", "nmax_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
