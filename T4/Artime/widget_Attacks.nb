       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["u", "n"]}], ")"}]}], ")"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GiantComponentVsThreshSF", "[", 
