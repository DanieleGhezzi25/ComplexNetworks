          RowBox[{"-", "meandeg"}], "]"}]}], 
        RowBox[{"i", "!"}]], 
       FractionBox["1", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], "nmax"], 
         FractionBox[
          RowBox[{
           RowBox[{"meandeg", "^", "k"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", "meandeg"}], "]"}]}], 
          RowBox[{"k", "!"}]]}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
