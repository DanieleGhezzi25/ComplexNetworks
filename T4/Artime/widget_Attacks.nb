         RowBox[{"HurwitzZeta", "[", 
          RowBox[{"alpha", ",", 
           RowBox[{"kmax", "+", "1"}]}], "]"}]}]], 
       RowBox[{"i", "^", 
        RowBox[{"-", "alpha"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "k0", ",", "kmax"}], "}"}]}], "]"}]}], 
