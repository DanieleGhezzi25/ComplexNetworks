        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"PhiHubs", "[", 
           RowBox[{
            RowBox[{"n", "+", "1"}], ",", "thresh"}], "]"}], "+", 
          RowBox[{
           RowBox[{"PhiHubs", "[", 
            RowBox[{
             RowBox[{"n", "+", "1"}], ",", "thresh"}], "]"}], "*", 
           FractionBox["1", 
            RowBox[{
             RowBox[{"meandegreeSF", "[", 
              RowBox[{"alpha", ",", "k0", ",", "kmax"}], "]"}], "-", 
             RowBox[{"k0", "*", 
              RowBox[{
               RowBox[{"pkSF", "[", 
                RowBox[{"alpha", ",", "k0", ",", "kmax"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}]], 
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}], 
           RowBox[{
            RowBox[{"pkSF", "[", 
             RowBox[{"alpha", ",", "k0", ",", "kmax"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"n", "+", "1", "+", "1", "-", "k0"}], "]"}], "]"}], "*", 
           
           SuperscriptBox["u", "n"]}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0.01", ",", "1", ",", "0.02"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GCSF", "[", 
