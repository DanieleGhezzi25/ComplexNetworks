Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Functions", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pk", "[", 
     RowBox[{"meandeg_", ",", "nmax_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"meandeg", "^", "i"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "meandeg"}], "]"}]}], 
        RowBox[{"i", "!"}]], 
       FractionBox["1", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], "nmax"], 
         FractionBox[
          RowBox[{
           RowBox[{"meandeg", "^", "k"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", "meandeg"}], "]"}]}], 
          RowBox[{"k", "!"}]]}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lhs", ":=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.01", ",", "1", ",", "0.02"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rhs", "[", 
      RowBox[{"meandeg_", ",", "nmax_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"1", " ", "-", " ", "phi", "+", 
        RowBox[{"phi", "*", 
         FractionBox["1", "meandeg"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"n", "=", "0"}], 
           RowBox[{"nmax", "-", "1"}]], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}], 
           RowBox[{
            RowBox[{"pk", "[", 
             RowBox[{"meandeg", ",", "nmax"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"n", "+", "1", "+", "1"}], "]"}], "]"}], "*", 
           SuperscriptBox["u", "n"]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0.01", ",", "1", ",", "0.02"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GC", "[", 
     RowBox[{"meandeg_", ",", "nmax_", ",", "phi_", ",", "u_"}], "]"}], ":=", 
    
    RowBox[{"phi", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "nmax"], 
        RowBox[{
         RowBox[{
          RowBox[{"pk", "[", 
           RowBox[{"meandeg", ",", "nmax"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"n", "+", "1"}], "]"}], "]"}], "*", 
         SuperscriptBox["u", "n"]}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GiantComponentVsPhi", "[", 
     RowBox[{"meandeg_", ",", "nmax_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GC", "[", 
        RowBox[{"meandeg", ",", "nmax", ",", "varphi", ",", "u"}], "]"}], "/.", 
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"u", "-", 
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "varphi", "+", 
               RowBox[{"varphi", "*", 
                FractionBox["1", "meandeg"], 
                RowBox[{
                 UnderoverscriptBox["\[Sum]", 
                  RowBox[{"n", "=", "0"}], 
                  RowBox[{"nmax", "-", "1"}]], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"n", "+", "1"}], ")"}], 
                  RowBox[{
                   RowBox[{"pk", "[", 
                    RowBox[{"meandeg", ",", "nmax"}], "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "+", "1", "+", "1"}], "]"}], "]"}], "*", 
                  SuperscriptBox["u", "n"]}]}]}]}], ")"}]}], "\[Equal]", 
            "0"}], " ", "&&", 
           RowBox[{"u", "<=", "1"}], " ", "&&", " ", 
           RowBox[{"u", ">=", "0"}]}], ",", "u", ",", "Reals"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"varphi", ",", "0.01", ",", "1", ",", "0.01"}], "}"}]}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GiantComponentVsMeanDegree", "[", 
     RowBox[{"phi_", ",", "nmax_", ",", "meandegmin_", ",", "meandegmax_"}], 
     "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GC", "[", 
        RowBox[{"varmeandeg", ",", "nmax", ",", "phi", ",", "u"}], "]"}], "/.", 
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"u", "-", 
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "phi", "+", 
               RowBox[{"phi", "*", 
                FractionBox["1", "varmeandeg"], 
                RowBox[{
                 UnderoverscriptBox["\[Sum]", 
                  RowBox[{"n", "=", "0"}], 
                  RowBox[{"nmax", "-", "1"}]], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"n", "+", "1"}], ")"}], 
                  RowBox[{
                   RowBox[{"pk", "[", 
                    RowBox[{"varmeandeg", ",", "nmax"}], "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "+", "1", "+", "1"}], "]"}], "]"}], "*", 
                  SuperscriptBox["u", "n"]}]}]}]}], ")"}]}], "\[Equal]", 
            "0"}], " ", "&&", 
           RowBox[{"u", "<=", "1"}], " ", "&&", " ", 
           RowBox[{"u", ">=", "0"}]}], ",", "u", ",", "Reals"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
       "varmeandeg", ",", "meandegmin", ",", "meandegmax", ",", "0.1"}], 
       "}"}]}], "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
