     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"1", " ", "-", " ", "phi", "+", 
        RowBox[{"phi", "*", 
         FractionBox["1", 
          RowBox[{
           RowBox[{"meandegree", "[", 
            RowBox[{"alpha", ",", "k0", ",", "kmax"}], "]"}], "-", 
