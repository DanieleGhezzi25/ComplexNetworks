   RowBox[{
    RowBox[{"meandegree", "[", 
     RowBox[{"alpha_", ",", "k0_", ",", "kmax_"}], "]"}], ":=", 
    FractionBox[
     RowBox[{
      RowBox[{"HurwitzZeta", "[", 
       RowBox[{
        RowBox[{"alpha", "-", "1"}], ",", "k0"}], "]"}], "-", 
      RowBox[{"HurwitzZeta", "[", 
       RowBox[{
        RowBox[{"alpha", "-", "1"}], ",", 
