           SuperscriptBox["u", "n"]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0.01", ",", "1", ",", "0.02"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GC", "[", 
