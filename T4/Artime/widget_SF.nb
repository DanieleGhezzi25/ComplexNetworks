          UnderoverscriptBox["\[Sum]", 
           RowBox[{"n", "=", "k0"}], 
           RowBox[{"kmax", "-", "1"}]], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}], 
